{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "*.ps1",
      "*.csv",
      "*.xlsx",
      "*.pdf",
      ".claude",
      "sa.json",
      "firebase_auth.txt",
      "firestore_raw.json",
      "firestore_data.json",
      "firestore_alim.json",
      "nm_export.json",
      "nm_alimentacion_export.json",
      "training_raw.json",
      "nutrition_raw.json",
      "menu_abril20.json"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
          { "key": "Pragma",        "value": "no-cache" },
          { "key": "Expires",       "value": "0" }
        ]
      },
      {
        "source": "sw-alimentacion.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
          { "key": "Service-Worker-Allowed", "value": "/" }
        ]
      },
      {
        "source": "sw-training.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
          { "key": "Service-Worker-Allowed", "value": "/" }
        ]
      },
      {
        "source": "manifest-alimentacion.json",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      }
    ]
  }
}
